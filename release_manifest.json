{
  "repository": "yunju-baek/computer-architecture-verilog-tutorial",
  "release_profile": "tutorial-webbook-and-hw01-hw02",
  "version": "tutorial-1.2.0",
  "published": [
    "tutorial",
    "tutorial_en",
    "webbook",
    "check_packet",
    "check_packet_en",
    "assignments",
    "assignments_en"
  ],
  "assignments": [
    "hw01",
    "hw02"
  ],
  "assignment_release_policy": "Publish HW01 and HW02 only. HW03 and HW04 remain topic previews until separately authorized.",
  "webbook": {
    "pages": 24,
    "languages": [
      "ko",
      "en"
    ],
    "source": "tutorial/**/README.md, tutorial_en/**/README.md",
    "url": "https://yunju-baek.github.io/computer-architecture-verilog-tutorial/"
  },
  "toolchain": {
    "iverilog_mode": "-g2012",
    "student_rtl": "Verilog-2001 core subset",
    "testbench": "Verilog and SystemVerilog supported by Icarus Verilog"
  },
  "check_packet": {
    "path": "check_packet/",
    "checks": [
      "check1: ch01-ch05, 20 predictions",
      "check2: ch06-ch10, 17 predictions + tb_boundary 12 vectors"
    ],
    "student_inputs": "derived from STUDENT_ID in student.mk (common/lcg.vh)",
    "submission": "make package -> verilog_checkN_<id>.zip"
  },
  "check_packet_en": {
    "path": "check_packet_en/",
    "checks": [
      "check1: ch01-ch05, 20 predictions",
      "check2: ch06-ch10, 17 predictions + tb_boundary 12 vectors"
    ],
    "student_inputs": "derived from STUDENT_ID in student.mk (common/lcg.vh)",
    "submission": "make package -> verilog_checkN_<id>.zip"
  },
  "assignment_languages": {
    "ko": "assignments",
    "en": "assignments_en"
  },
  "assignment_version": "archlab-3.0.0-hw01-hw02",
  "assignment_previews": {
    "hw03": "Single-cycle core integration; topic only",
    "hw04": "Pipeline dependencies and performance; topic only"
  },
  "lms_announcements": "instructor-held; excluded from public files and downloads"
}
