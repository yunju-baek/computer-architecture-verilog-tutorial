{
  "repository": "yunju-baek/computer-architecture-verilog-tutorial",
  "release_profile": "tutorial-webbook",
  "version": "tutorial-1.2.0",
  "published": [
    "tutorial",
    "tutorial_en",
    "webbook",
    "check_packet",
    "check_packet_en"
  ],
  "assignments": [],
  "assignment_release_policy": "Add each assignment to the public Git history at its announced release time.",
  "webbook": {
    "pages": 24,
    "languages": [
      "ko",
      "en"
    ],
    "source": "tutorial/**/README.md, tutorial_en/**/README.md",
    "url": "https://yunju-baek.github.io/computer-architecture-verilog-tutorial/"
  },
  "toolchain": {
    "iverilog_mode": "-g2012",
    "student_rtl": "Verilog-2001 core subset",
    "testbench": "Verilog and SystemVerilog supported by Icarus Verilog"
  },
  "check_packet": {
    "path": "check_packet/",
    "checks": [
      "check1: ch01-ch05, 20 predictions",
      "check2: ch06-ch10, 17 predictions + tb_boundary 12 vectors"
    ],
    "student_inputs": "derived from STUDENT_ID in student.mk (common/lcg.vh)",
    "submission": "make package -> verilog_checkN_<id>.zip"
  },
  "check_packet_en": {
    "path": "check_packet_en/",
    "checks": [
      "check1: ch01-ch05, 20 predictions",
      "check2: ch06-ch10, 17 predictions + tb_boundary 12 vectors"
    ],
    "student_inputs": "derived from STUDENT_ID in student.mk (common/lcg.vh)",
    "submission": "make package -> verilog_checkN_<id>.zip"
  }
}
